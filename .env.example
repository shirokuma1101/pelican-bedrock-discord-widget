# Discord connection and target channels
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_TO_MINECRAFT_CHANNEL_ID=
DISCORD_MESSAGE_ID=

# Pelican Panel API
PELICAN_BASE_URL=https://panel.example.com
PELICAN_SERVER_ID=
PELICAN_CLIENT_API_TOKEN=

# Minecraft Bedrock server
BEDROCK_HOST=127.0.0.1
BEDROCK_PORT=19132

# Widget update, presence, and public server display
UPDATE_INTERVAL_SECONDS=15
PRESENCE_ENABLED=true
PUBLIC_ADDRESS=
WEBSITE_URL=https://example.com/

# Optional maintenance-cost estimate (power metric, electricity, and domain)
VICTORIA_METRICS_URL=
VICTORIA_METRICS_QUERY=ohm_cpu_watts{instance="server",sensor="CPU Package"}
POWER_AVERAGE_WINDOW=7d
ELECTRICITY_YEN_PER_KWH=32.6
DOMAIN_ANNUAL_COST_YEN=0
HDD_COUNT=1
HDD_WATTS_EACH=8
SSD_COUNT=2
SSD_WATTS_EACH=3
OTHER_HARDWARE_WATTS=30

# AI chat through the DeepSeek OpenAI-compatible API
# Mention the bot in this channel to start a temporary AI chat thread.
LLM_ENABLED=false
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_ALLOWED_CHANNEL_ID=
LLM_SYSTEM_PROMPT=あなたはMinecraftサーバーの親しみやすい雑談Botです。簡潔に日本語で返答してください。
LLM_TIMEOUT_SECONDS=120
LLM_MAX_HISTORY_MESSAGES=20
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_MAX_TOKENS=512
LLM_DATABASE_FILE=data/llm_chat.sqlite3
# First-use consent text shown before AI chat starts.
LLM_TERMS_TEXT=AIの回答には誤りが含まれる場合があります。個人情報・機密情報を送信しないでください。入力内容と、許可した場合は過去の発言がDeepSeek APIへ送信され、会話履歴・長期記憶・同意設定がBotのデータベースに保存されます。
# Maximum number of the consenting user's messages used to create one profile summary.
LLM_HISTORY_LEARN_MESSAGES=30
# Maximum number of channel messages searched to find that user's messages.
LLM_HISTORY_SCAN_LIMIT=500

# Ko-fi support and goal display
KO_FI_URL=
KO_FI_GOAL_TITLE=
KO_FI_GOAL_PERCENTAGE=
KO_FI_GOAL_CURRENT=
KO_FI_GOAL_TARGET=

# Persistent donation and playtime data
DONATIONS_FILE=data/donations.json
PLAYTIME_FILE=data/playtime.json
PLAYTIME_RESET_CRON=0 0 1 * *

# Wings/Pelican WebSocket console integration
CONSOLE_ENABLED=true
CONSOLE_LOG_LINES=5
PLAYER_LIST_ENABLED=true
PLAYER_LIST_COMMAND_INTERVAL_SECONDS=30
MAX_PLAYERS_DISPLAYED=20
PLAYER_EMOJI_FILE=data/player_emojis.json

# Optional Pelican power controls
ENABLE_CONTROL_BUTTONS=false
CONTROL_ROLE_IDS=

# Dynamic VC + listen-only channel pairs (disabled when category ID is empty)
DYNAMIC_VOICE_CATEGORY_ID=
DYNAMIC_VOICE_EMPTY_MINUTES=10
# 0 means unlimited; slash command can override this per channel set.
DYNAMIC_VOICE_DEFAULT_LIMIT=0
DYNAMIC_VOICE_FILE=data/dynamic_voice.json
DYNAMIC_VOICE_REACTIONS_FILE=data/dynamic_voice_reactions.json

# Notify Minecraft chat when users join or leave this Discord VC
MINECRAFT_NOTIFY_VOICE_CHANNEL_ID=

# Application logging
LOG_LEVEL=INFO
